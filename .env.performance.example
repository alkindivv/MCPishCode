# Local source build only. This file contains no credentials and is NOT auto-loaded.
# After npm ci && npm run build, run:
# node --env-file=.env.performance.example dist/cli.js serve
# Existing exported environment variables take precedence over this file.
# Keep allowed roots, public URL and OAuth configuration in your existing config.
MCPISHCODE_WIDGETS=off
MCPISHCODE_OUTPUT_MODE=compact
MCPISHCODE_MAX_OUTPUT_CHARS=8000
MCPISHCODE_MAX_PREVIEW_CHARS=24000
MCPISHCODE_DEFAULT_READ_LINES=160
MCPISHCODE_MAX_READ_LINES=2000
MCPISHCODE_OUTPUT_CACHE_BYTES=16777216
MCPISHCODE_OUTPUT_ENTRY_BYTES=1048576
MCPISHCODE_OUTPUT_CACHE_TTL_MS=900000
MCPISHCODE_MAX_PROCESS_SESSIONS=16
MCPISHCODE_MAX_MCP_SESSIONS=32
MCPISHCODE_MCP_IDLE_TTL_MS=3600000
MCPISHCODE_PROCESS_BUFFER_CHARS=64000
MCPISHCODE_DEFAULT_OUTPUT_TOKENS=2000
MCPISHCODE_MAX_CONTEXT_ENTRIES=30
MCPISHCODE_MAX_CONTEXT_SCAN_ENTRIES=50000
MCPISHCODE_CONTEXT_SCAN_TIMEOUT_MS=3000
# Optional: use minimal when fewer tool descriptors are preferred.
# MCPISHCODE_TOOL_MODE=minimal
# Do not disable project instructions or skills just to save context.
